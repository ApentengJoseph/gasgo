# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/gasdelivery
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gasdelivery?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# OTP Configuration
OTP_EXPIRES_IN=300000
OTP_LENGTH=6

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_CALLBACK_URL=http://localhost:3000/api/payments/callback

# SMS Service (Termii, Twilio, etc.)
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://api.termii.com/api/sms/send
SMS_SENDER_ID=GASO

# Email Service (SendGrid, AWS SES, etc.)
EMAIL_API_KEY=your_email_api_key
EMAIL_FROM=noreply@gasdelivery.com
EMAIL_FROM_NAME=Gaso Delivery

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
